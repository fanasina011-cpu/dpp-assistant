venv/
.venv/
env/
ENV/

# Tests / couverture
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# Django — runtime
*.log
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# Variables d'environnement (JAMAIS versionnées)
.env
.env.local
.env.*.local
!.env.example

# =========================================================
# Node / React / Vite (le .gitignore de frontend/ couvre le reste)
# =========================================================
node_modules/
dist/
dist-ssr/
.vite/
*.tsbuildinfo
.eslintcache

# =========================================================
# IDE / Éditeurs
# =========================================================
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# =========================================================
# OS
# =========================================================
.DS_Store
Thumbs.db
desktop.ini

# =========================================================
# Outils internes
