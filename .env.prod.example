# Générer la SECRET_KEY avec :
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=generate-me

DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=dpp.example.com,www.dpp.example.com
CORS_ALLOWED_ORIGINS=https://dpp.example.com

DB_NAME=dpp_assistant
DB_USER=dpp_user
DB_PASSWORD=<strong-password>
DB_HOST=mysql
DB_PORT=3306

MYSQL_ROOT_PASSWORD=<strong-root-password>

REDIS_PASSWORD=<strong-redis-password>

VITE_API_URL=https://dpp.example.com
